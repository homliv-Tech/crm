# Primary read/write Neon connection; a read replica cannot run CRM writes.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-PRIMARY-ENDPOINT.neon.tech/neondb?sslmode=require"
# Generate local credentials with npm run setup, or choose your own values.
CRM_PASSWORD="replace-with-at-least-12-characters"
SESSION_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
