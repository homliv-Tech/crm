# Primary read/write Neon connection.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-PRIMARY-ENDPOINT.neon.tech/neondb?sslmode=require"
# WorkOS Dashboard > API Keys. Keep the API key server-only.
WORKOS_API_KEY=""
WORKOS_CLIENT_ID=""
# Only members of this organization can access this shared CRM database.
WORKOS_ORGANIZATION_ID=""
# Generated by bun run setup; at least 32 random characters.
WORKOS_COOKIE_PASSWORD=""
NEXT_PUBLIC_WORKOS_REDIRECT_URI="http://localhost:3000/callback"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Exact origin of the public quotation maker allowed to connect to this CRM.
QUOTATIONS_ORIGIN="http://localhost:3001"

# Server-only shared secret for the landing site's enquiry integration (32+ characters).
# Generated by bun run setup; existing valid secrets are preserved.
# Leave empty to disable the endpoint. Use the same value as CRM_ENQUIRY_SECRET there.
LANDING_ENQUIRY_SECRET=""
