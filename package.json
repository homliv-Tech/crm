{
  "name": "crm-monorepo",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "bun run --filter @crm/web start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "setup": "bun run --filter @crm/web setup",
    "db:generate": "bun run --filter @crm/web db:generate",
    "db:migrate": "bun run --filter @crm/web db:migrate",
    "db:studio": "bun run --filter @crm/web db:studio",
    "db:seed": "bun run --filter @crm/web db:seed",
    "test:integration": "bun run --filter @crm/web test:integration"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
