{
  "name": "crm-monorepo",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "npm run start --workspace @crm/web --",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "setup": "npm run setup --workspace @crm/web",
    "db:generate": "npm run db:generate --workspace @crm/web",
    "db:migrate": "npm run db:migrate --workspace @crm/web",
    "db:studio": "npm run db:studio --workspace @crm/web",
    "db:seed": "npm run db:seed --workspace @crm/web --",
    "test:integration": "npm run test:integration --workspace @crm/web --"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
